<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">

  <title>Hoppscotch Uninstaller — TEST MODE</title>

  <welcome    file="welcome-test.html"    mime-type="text/html" />
  <conclusion file="conclusion-test.html" mime-type="text/html" />

  <os-version min="12.0" />

  <!-- customize="never"     → hides "Installation Type" pane.
       rootVolumeOnly="true" → hides "Destination Select" pane.
       Do NOT add <domains> — it re-enables the Destination Select UI. -->
  <options
    customize="never"
    rootVolumeOnly="true"
  />

  <pkg-ref id="io.hoppscotch.uninstaller.test" />

  <choices-outline>
    <line choice="io.hoppscotch.uninstaller.test" />
  </choices-outline>

  <choice
    id="io.hoppscotch.uninstaller.test"
    visible="false"
    start_selected="true"
    start_enabled="false"
    start_visible="false"
    title="Hoppscotch Uninstaller TEST"
    description="Dry-run only — scans and reports what would be removed. Nothing is deleted."
  >
    <pkg-ref id="io.hoppscotch.uninstaller.test" />
  </choice>

  <pkg-ref
    id="io.hoppscotch.uninstaller.test"
    version="1.0.0"
    onConclusion="none"
  >component-test.pkg</pkg-ref>

</installer-gui-script>

