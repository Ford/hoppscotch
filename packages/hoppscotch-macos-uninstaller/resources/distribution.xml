<?xml version="1.0" encoding="utf-8"?>
<!--
  distribution.xml — productbuild distribution file for Hoppscotch Uninstaller

  This file controls the macOS Installer GUI experience (title, welcome screen,
  conclusion screen, and the single-choice "installation" that actually runs
  the uninstall scripts).
-->
<installer-gui-script minSpecVersion="2">

  <title>Remove Hoppscotch from This Mac</title>

  <!-- GUI screens -->
  <welcome    file="welcome.html"    mime-type="text/html" />
  <conclusion file="conclusion.html" mime-type="text/html" />

  <!-- Require macOS 12 (Monterey) or later — matches Hoppscotch minimum -->
  <os-version min="12.0" />

  <!-- Options: no customisation; must install to the boot volume.
       customize="never"   → hides the Installation Type pane.
       rootVolumeOnly="true" → hides the Destination Select pane. -->
  <options
    customize="never"
    require-scripts="false"
    rootVolumeOnly="true"
    allow-external-scripts="false"
  />

  <!-- Restrict to local system domain only (no user-home option),
       which prevents the Destination Select pane from appearing. -->
  <domains enable_localSystem="true" />

  <!-- JavaScript: auto-confirm the root volume so the installer
       never pauses to ask the user where to install. -->
  <script>
  function volume_check() { return true; }
  function pm_install_check() { return true; }
  </script>

  <!-- Flat (no group wrapper) choices-outline — a nested default group
       can cause the Installation Type pane to appear even with
       customize="never". A single flat line avoids that. -->
  <pkg-ref id="io.hoppscotch.uninstaller" />

  <choices-outline>
    <line choice="io.hoppscotch.uninstaller" />
  </choices-outline>

  <choice
    id="io.hoppscotch.uninstaller"
    visible="false"
    start_selected="true"
    start_enabled="false"
    start_visible="false"
    title="Hoppscotch Uninstaller"
    description="Removes Hoppscotch and all associated data from this Mac."
  >
    <pkg-ref id="io.hoppscotch.uninstaller" />
  </choice>

  <pkg-ref
    id="io.hoppscotch.uninstaller"
    version="1.0.0"
    onConclusion="none"
  >component.pkg</pkg-ref>

</installer-gui-script>

