#!/usr/bin/env bash
# =============================================================================
# preinstall — Hoppscotch Uninstaller PKG preflight check
# =============================================================================
# Runs as root before the payload is laid down.
# We use this to verify the environment and log context for MDM reporting.
#
# IMPORTANT: This script must always exit 0.
# If it exits non-zero, macOS Installer shows an error dialog and — when the
# user clicks Close on that dialog — macOS triggers a storage-access permission
# prompt as part of its failure-cleanup path.  Warnings are logged; the actual
# removal work is handled by postinstall → uninstall.sh.
# =============================================================================

set -uo pipefail   # Note: NO -e  — we handle every error explicitly below

readonly APP_ID="io.hoppscotch.desktop"
readonly APP_BUNDLE="/Applications/Hoppscotch.app"

echo "[Hoppscotch Uninstaller] Preflight check starting..."
echo "[Hoppscotch Uninstaller] macOS version: $(sw_vers -productVersion)"
echo "[Hoppscotch Uninstaller] Architecture : $(uname -m)"

# Check whether the app or its data exist
if [[ -d "$APP_BUNDLE" ]]; then
  echo "[Hoppscotch Uninstaller] App bundle found: $APP_BUNDLE"
else
  echo "[Hoppscotch Uninstaller] App bundle NOT found — data-only cleanup will proceed."
fi

# Check write permission to /Applications — warn only, never fail.
# The PKG runs as root via system_installd so this check almost always passes.
# If it does not, uninstall.sh will handle the error gracefully at runtime.
if [[ ! -w "/Applications" ]]; then
  echo "[Hoppscotch Uninstaller] WARNING: /Applications may not be writable — removal will be attempted anyway." >&2
else
  echo "[Hoppscotch Uninstaller] /Applications is writable."
fi

echo "[Hoppscotch Uninstaller] Preflight check passed."
exit 0   # Always exit 0 — never let preinstall trigger the Installer error path
