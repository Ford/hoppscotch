  <!-- File table -->
  <div class="table-wrap">
    <div class="table-head">
      <span>📁 Files &amp; Folders scanned on this Mac</span>
      <span>${found_count} items would be removed</span>
    </div>
    <table>
      <thead>
        <tr>
          <th>Path</th>
          <th>Size</th>
