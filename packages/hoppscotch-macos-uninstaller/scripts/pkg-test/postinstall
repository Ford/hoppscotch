      background: #f0f0f5;
      padding: 2px 7px;
      border-radius: 4px;
      font-family: monospace;
      font-size: 12.5px;
    }
  </style>
</head>
<body>
<div class="container">

  <!-- Test banner -->
  <div class="test-banner">
    <div class="icon">🧪</div>
    <div>
      <strong>TEST MODE — Nothing was deleted</strong>
      <p>This report was generated by the Hoppscotch Uninstaller Test Package.
         All items below are shown for review only. No files or folders were
