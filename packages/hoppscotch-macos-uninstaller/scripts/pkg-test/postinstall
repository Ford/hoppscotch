<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Hoppscotch Uninstall Preview — Test Report</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px;
      background: #f5f5f7;
      color: #1d1d1f;
      padding: 32px 24px;
      line-height: 1.6;
    }

    .container { max-width: 860px; margin: 0 auto; }

    /* ── Test Mode Banner ── */
    .test-banner {
      background: #fff3cd;
      border: 2px solid #ffc107;
      border-radius: 10px;
      padding: 14px 20px;
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .test-banner .icon { font-size: 24px; }
    .test-banner strong { font-size: 15px; color: #856404; }
    .test-banner p { font-size: 13px; color: #856404; margin-top: 2px; }

    /* ── Header ── */
    .header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
    }
    .logo {
      width: 52px; height: 52px;
      background: linear-gradient(135deg, #31C48D, #0EA5E9);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 26px;
    }
    h1 { font-size: 24px; font-weight: 700; }
    h1 span { color: #6e6e73; font-size: 15px; font-weight: 400; display: block; margin-top: 2px; }

    /* ── Summary cards ── */
    .summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 28px;
    }
    .card {
      background: #fff;
      border-radius: 10px;
      padding: 16px 20px;
      border: 1px solid #e0e0e5;
    }
    .card .number {
      font-size: 32px;
      font-weight: 700;
      line-height: 1;
      margin-bottom: 4px;
    }
    .card .label { font-size: 12px; color: #6e6e73; text-transform: uppercase; letter-spacing: .5px; }
    .card.total  .number { color: #1d1d1f; }
