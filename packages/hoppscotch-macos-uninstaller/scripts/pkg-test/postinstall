#!/usr/bin/env bash
# =============================================================================
# postinstall — Hoppscotch TEST PKG
# =============================================================================
# Scans the Mac for every file/folder the real uninstaller would remove.
# Generates a self-contained HTML report and opens it in the default browser.
# NOTHING IS DELETED.
# =============================================================================

set -euo pipefail

readonly APP_ID="io.hoppscotch.desktop"
readonly APP_NAME="Hoppscotch"
readonly APP_BUNDLE="/Applications/${APP_NAME}.app"
readonly REPORT_FILE="/tmp/Hoppscotch-Uninstall-Preview-$(date +%Y%m%d-%H%M%S).html"

echo "[TEST] Scanning system — nothing will be deleted..."

# ── Collect paths ─────────────────────────────────────────────────────────────
# Each entry: "STATUS|PATH|SIZE"  (STATUS = FOUND | MISSING)
declare -a ROWS=()

scan_path() {
  local path="$1"
  if [[ -e "$path" ]]; then
    local size
    size=$(du -sh "$path" 2>/dev/null | cut -f1 || echo "—")
    ROWS+=("FOUND|${path}|${size}")
    echo "[TEST]   ✓ Found   : $path  ($size)"
  else
    ROWS+=("MISSING|${path}|—")
    echo "[TEST]   – Missing : $path"
  fi
}

# App bundle
scan_path "$APP_BUNDLE"

# Per-user Library data
user_homes=()
while IFS=$'\t' read -r _user home; do
  [[ "$home" == /Users/* && -d "$home" ]] || continue
  user_homes+=("$home")
done < <(dscl . -list /Users NFSHomeDirectory 2>/dev/null | awk '{print $1"\t"$2}' || true)

for home in "${user_homes[@]}"; do
  lib="$home/Library"
  scan_path "$lib/Application Support/${APP_ID}"
  scan_path "$lib/Logs/${APP_ID}"
  scan_path "$lib/Caches/${APP_ID}"
  scan_path "$lib/WebKit/${APP_ID}"
  scan_path "$lib/Saved Application State/${APP_ID}.savedState"
  scan_path "$lib/HTTPStorages/${APP_ID}"
  scan_path "$lib/Preferences/${APP_ID}.plist"
done

# LaunchAgents / Daemons
for dir in /Library/LaunchDaemons /Library/LaunchAgents /Users/*/Library/LaunchAgents; do
  [[ -d "$dir" ]] || continue
  while IFS= read -r -d '' plist; do
    scan_path "$plist"
  done < <(find "$dir" -maxdepth 1 -name "*${APP_ID}*" -print0 2>/dev/null || true)
done

# ── Count results ─────────────────────────────────────────────────────────────
found_count=0
missing_count=0
for row in "${ROWS[@]}"; do
  [[ "$row" == FOUND* ]]   && (( found_count++   )) || true
  [[ "$row" == MISSING* ]] && (( missing_count++ )) || true
done
total_count=$(( found_count + missing_count ))

# ── Build HTML rows ───────────────────────────────────────────────────────────
html_rows=""
for row in "${ROWS[@]}"; do
  status="${row%%|*}"
  rest="${row#*|}"
  path="${rest%%|*}"
  size="${rest##*|}"

  if [[ "$status" == "FOUND" ]]; then
    badge='<span class="badge found">Will be removed</span>'
    row_class="found"
  else
    badge='<span class="badge missing">Not present</span>'
    row_class="missing"
  fi

  html_rows+="
    <tr class=\"${row_class}\">
      <td class=\"path\">${path}</td>
      <td class=\"size\">${size}</td>
      <td>${badge}</td>
    </tr>"
done

# ── Generate self-contained HTML report ──────────────────────────────────────
cat > "$REPORT_FILE" << HTMLEOF
